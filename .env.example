# Copy to .env.local and fill in. Never commit .env.local.

# Phase 0b — Azure AI Speech (server only)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Phase 1 — Supabase (docs/supabase-setup.md). Leave both empty to run Melobi without sign-in.
# Project Settings -> API: Project URL, and the anon / publishable key (safe for the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only, only if needed. NEVER prefix with NEXT_PUBLIC_. Not used by the app today.

# AI features: Ask Melobi and reading handwritten IPA (server only). Set one key, or both and choose with AI_PROVIDER.
# Without AI_PROVIDER the app uses Claude when ANTHROPIC_API_KEY is set, otherwise Gemini.
ANTHROPIC_API_KEY=
# Gemini: Google AI Studio key. On the free tier Google may use requests to improve its products; a paid key does not.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash   # models to try in order (default list in src/lib/ai/aiServer.ts)
# AI_PROVIDER=claude   # or gemini
